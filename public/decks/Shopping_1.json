    {
      "hanzi": "便",
      "pinyin": "biàn",
      "meaning": "convenient",
      "examples": [
        {
          "hanzi": "这里买东西很方便。",
          "pinyin": "zhè lǐ mǎi dōng xi hěn fāng biàn",
